    "@payloadcms/ui": "3.85.0",
    "graphql": "16.11.0",
    "lucide-react": "1.28.0",
    "next": "16.2.9",
    "next-themes": "0.4.6",
    "payload": "3.85.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.18.1",
    "sharp": "0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.9",
    "jsdom": "30.0.1",
