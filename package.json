{
  "name": "felipe-henriquez-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "quality": "eslint . --max-warnings=0 && tsc --noEmit && vitest run && next build",
    "payload": "payload",
    "payload:types": "payload generate:types",
    "payload:importmap": "payload generate:importmap",
    "payload:seed": "payload run scripts/seed-payload.ts",
    "payload:validate-content": "payload run scripts/validate-payload-content.ts",
    "payload:validate-storage": "payload run scripts/validate-supabase-storage.ts",
    "payload:validate-blog": "payload run scripts/validate-blog.ts",
    "payload:migrate": "payload migrate",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate:status": "payload migrate:status",
    "preview:env:check": "node scripts/check-preview-env.mjs",
    "preview:migrate:status": "node scripts/run-preview.mjs payload migrate:status",
    "preview:migrate": "node scripts/run-preview.mjs payload migrate",
    "preview:seed": "node scripts/run-preview.mjs payload run scripts/seed-payload.ts",
    "preview:validate-content": "node scripts/run-preview.mjs payload run scripts/validate-payload-content.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/next": "3.85.0",
