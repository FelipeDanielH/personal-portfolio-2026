NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity: leave empty to use the bundled local content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
SANITY_DRAFT_SECRET=

# Resend: required to enable the contact form delivery.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portafolio <contacto@your-domain.example>
