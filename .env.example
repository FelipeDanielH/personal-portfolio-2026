NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload: use the pooled URL of the corresponding Neon branch.
# Keep separate values in local, preview and production environments.
DATABASE_URL=postgresql://user:password@development-branch-pooler.example.neon.tech/neondb?sslmode=require
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Supabase Storage: S3-compatible server-side access for Payload Media only.
# PUBLIC_URL is the public bucket base, including /storage/v1/object/public/<bucket>.
SUPABASE_STORAGE_BUCKET=portfolio-media-development
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_ACCESS_KEY_ID=replace-with-s3-access-key
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-with-s3-secret-key
SUPABASE_STORAGE_ENDPOINT=https://project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_PUBLIC_URL=https://project-ref.supabase.co/storage/v1/object/public/portfolio-media-development

# Sanity: leave empty to use the bundled local content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
SANITY_DRAFT_SECRET=

# Resend: required to enable the contact form delivery.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portafolio <contacto@your-domain.example>
